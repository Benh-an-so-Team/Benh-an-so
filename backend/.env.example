# ==============================================================================
# HỆ THỐNG BỆNH SỐ ÁN - BIẾN MÔI TRƯỜNG MẪU (BACKEND)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép file này thành .env:
#    cp .env.example .env (hoặc copy trên Windows)
# 2. Điền thông tin cấu hình thực tế cho máy của bạn vào file .env
# 3. TUYỆT ĐỐI KHÔNG commit file .env chứa thông tin bí mật lên Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cấu hình Runtime & Profile
# ------------------------------------------------------------------------------
# Profile đang chạy: local (mặc định cho dev), dev (staging/cloud dev), prod (production)
SPRING_PROFILES_ACTIVE=local
PORT=8080

# ------------------------------------------------------------------------------
# 2. Cơ sở dữ liệu (MySQL / TiDB)
# ------------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/digital_medical_record?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# ------------------------------------------------------------------------------
# 3. Bảo mật & Xác thực JWT
# ------------------------------------------------------------------------------
# Khóa bí mật ký JWT - BẮT BUỘC tối thiểu 32 ký tự (256-bit)
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_characters_long
# Thời gian sống của JWT token (milliseconds): mặc định 900000ms = 15 phút
JWT_EXPIRATION_MS=900000

# ------------------------------------------------------------------------------
# 4. Lưu trữ tập tin kết quả khám bệnh (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=benh-soan/clinical-results
CLOUDINARY_SIGNED_URL_TTL=PT5M

# ------------------------------------------------------------------------------
# 5. Cấu hình gửi Mail (SMTP Gmail / SendGrid / Amazon SES)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Cấu hình CORS (Phân cách bởi dấu phẩy)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5173,http://localhost:4200,https://*.vercel.app

# ------------------------------------------------------------------------------
# 7. Cổng liên thông đơn thuốc giả lập (Mock Gateway)
# ------------------------------------------------------------------------------
INTERCONNECTION_MOCK_GATEWAY_ENABLED=false
INTERCONNECTION_MOCK_GATEWAY_MODE=ACCEPT
INTERCONNECTION_MOCK_GATEWAY_NO_RESPONSE_DELAY=PT15S
